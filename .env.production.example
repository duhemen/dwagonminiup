# ===== Database =====
POSTGRES_USER=dwagon
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=dwagon

# ===== Auth =====
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS

# ===== Image Tag (untuk versioning deploy) =====
IMAGE_TAG=v1.0.0

# ===== Domain (opsional, untuk SSL) =====
DOMAIN=dwagon.id
LETSENCRYPT_EMAIL=admin@dwagon.id